<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The smallest possible focused text field, for the inputText connected test.
             Exported because the instrumented process runs under the TARGET app's uid,
             which counts as another app to this test-package activity. -->
        <activity
            android:name="dev.nohavewho.flowbaton.TextEntryActivity"
            android:exported="true" />
        <!-- A WebView with content debugging on, so there is SOMETHING on this
             emulator publishing a DevTools endpoint: release Chrome publishes
             none and ignores /data/local/tmp/chrome-command-line. Exported for
             the same reason as the one above. -->
        <activity
            android:name="dev.nohavewho.flowbaton.WebViewHostActivity"
            android:exported="true" />
    </application>
</manifest>
